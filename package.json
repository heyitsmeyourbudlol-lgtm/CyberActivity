{
  "name": "cyberactivity",
  "productName": "CyberActivity",
  "version": "1.0.0",
  "description": "State-sponsored cyber briefing desk for macOS",
  "main": "electron/main.js",
  "author": "CyberActivity",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --mac dir --arm64 --x64",
    "dist": "electron-builder --mac dmg --arm64"
  },
  "build": {
    "appId": "studio.cyberactivity.app",
    "productName": "CyberActivity",
    "mac": {
      "category": "public.app-category.news",
      "target": [
        "dir"
      ],
      "identity": null,
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1"
  }
}
